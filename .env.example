# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/LifeUse
DB_USERNAME=postgres
DB_PASSWORD=postgress

# JWT Configuration
# Base64-encoded secret key (minimum 256 bits for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Access token expiration: 15 minutes (in milliseconds: 900000)
JWT_EXPIRATION_MS=900000
# Refresh token expiration: 7 days (in milliseconds: 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Email Provider Configuration (Optional / External)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@authapp.com

# SMS Provider Configuration (Optional / External)
SMS_ENABLED=false
SMS_PROVIDER_API_KEY=your_sms_api_key
SMS_SENDER_ID=AUTHAPP
